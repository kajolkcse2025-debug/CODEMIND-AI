  "paths": {
    "/api/v1/coding-assessment/health": {
      "get": {
        "description": "Check whether the coding assessment bank is available.",
        "operationId": "coding_assessment_health_api_v1_coding_assessment_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Coding Assessment Health",
        "tags": [
          "Coding Assessment"
        ]
      }
    },
    "/api/v1/coding-assessment/questions": {
      "get": {
        "description": "Return a selected set of coding assessment questions.",
        "operationId": "get_assessment_questions_api_v1_coding_assessment_questions_get",
        "parameters": [
          {
            "in": "query",
            "name": "count",
            "required": false,
            "schema": {
              "default": 8,
              "maximum": 8,
              "minimum": 1,
              "title": "Count",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Assessment Questions",
        "tags": [
          "Coding Assessment"
        ]
      }
    },
    "/api/v1/coding-assessment/{slug}/submit": {
      "post": {
        "description": "Run a student's code against an assessment question.",
        "operationId": "submit_assessment_code_api_v1_coding_assessment__slug__submit_post",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmissionCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Assessment Code",
        "tags": [
          "Coding Assessment"
        ]
      }
    },
