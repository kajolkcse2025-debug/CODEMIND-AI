# Copy to .env (never commit .env). Read by docker compose and by the API (apps/api).
# The web app has its own file: apps/web/.env.example (only public VITE_* values).

# ---- Local Postgres container (docker-compose.yml). Dev-only values: change them. ----
POSTGRES_USER=codemind
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=codemind

# ---- API ----
ENVIRONMENT=development            # development | test | staging | production
LOG_LEVEL=INFO
# Must match the Postgres values above. Railway's postgres:// URLs are accepted as-is.
DATABASE_URL=postgresql+psycopg://codemind:change-me-local-only@localhost:5432/codemind
REDIS_URL=redis://localhost:6379/0
# Comma-separated explicit origins. A wildcard is rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Firebase Authentication (backend verifies ID tokens) ----
# Required when ENVIRONMENT is staging or production.
FIREBASE_PROJECT_ID=
# base64 of the service-account JSON:  base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_B64=
# Local development WITHOUT a Firebase project: run the Firebase Auth emulator and set
#   FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# (refused in staging/production; the emulator accepts unsigned tokens, so never expose it)

# ---- AI (Phase 1 makes no AI calls; these only configure the abstraction) ----
AI_PROVIDER=gemini                 # gemini | fake (fake is refused in staging/production)
GEMINI_API_KEY=
AI_MODEL_FAST=
AI_MODEL_STRONG=
