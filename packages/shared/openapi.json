          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MeFlags": {
        "properties": {
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          }
        },
        "required": [
          "email_verified"
        ],
        "title": "MeFlags",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "flags": {
            "$ref": "#/components/schemas/MeFlags"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProfileOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "user",
          "profile",
          "flags"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "ProfileIn": {
        "additionalProperties": false,
        "description": "Used for both POST (create) and PUT (full replacement of the editable fields).\n\nUnknown fields are rejected, so a client can never smuggle in ``user_id`` or similar.",
        "properties": {
          "cgpa": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,2}|(?=[\\d.]{1,5}0*$)\\d{0,2}\\.\\d{0,2}0*$)",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cgpa"
          },
          "cgpa_scale": {
            "default": 10,
            "enum": [
              4,
              5,
              10
            ],
            "title": "Cgpa Scale",
            "type": "integer"
          },
          "codeforces_username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Codeforces Username"
          },
          "college": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "College"
          },
          "current_year": {
            "anyOf": [
              {
                "maximum": 8.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Year"
          },
          "daily_minutes": {
            "anyOf": [
              {
                "maximum": 720.0,
                "minimum": 15.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Daily Minutes"
          },
          "degree": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Degree"
          },
          "dream_company": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dream Company"
          },
          "dream_role": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dream Role"
          },
          "github_username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Github Username"
          },
          "leetcode_username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Leetcode Username"
          },
          "linkedin_url": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Linkedin Url"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "preferred_language": {
            "anyOf": [
              {
                "enum": [
                  "python",
                  "java",
                  "cpp"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preferred Language"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "maxItems": 30,
            "title": "Skills",
            "type": "array"
          },
          "target_package_lpa": {
            "anyOf": [
              {
                "exclusiveMaximum": 10000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Package Lpa"
          },
          "timezone": {
            "default": "UTC",
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ProfileIn",
        "type": "object"
      },
