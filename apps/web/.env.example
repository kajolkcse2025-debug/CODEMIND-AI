# Everything with a VITE_ prefix is bundled into the browser. NEVER put a secret here.
# Firebase web config values are public identifiers, not secrets (restrict the API key by
# HTTP referrer in the Google Cloud console).
VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: point the Firebase SDK at a local Auth emulator, e.g. http://localhost:9099
VITE_FIREBASE_AUTH_EMULATOR_URL=
